{
  "name": "dsh-plugin-jphone",
  "version": "0.1.2",
  "description": "小鲸同学 (JingChan / JPhone) — DeepSeek Harness AI companion plugin featuring desktop pet, voice calls, focus studio, diary & Mini-App workshop",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "skills",
    "web-dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "icon": "./assets/icon.png",
  "license": "MIT",
  "author": {
    "name": "easychen",
    "url": "https://github.com/easychen"
  },
  "homepage": "https://github.com/easychen/jing-chan-os",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easychen/jing-chan-os.git",
    "directory": "packages/dsh-plugin-jphone"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ai-companion",
    "desktop-pet",
    "voice-assistant",
    "focus-timer",
    "jingchan",
    "jphone",
    "小鲸同学"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bugs": {
    "url": "https://github.com/easychen/jing-chan-os/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
