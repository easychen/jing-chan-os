{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JingPhone Workshop Package Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version",
    "entry"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-_]{2,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "miniapp",
        "skill",
        "wallpaper",
        "character"
      ]
    },
    "version": {
      "type": "string"
    },
    "entry": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "storage",
          "chat.ask",
          "tasks.dispatch",
          "ui.notify",
          "ui.header",
          "audio.host",
          "notify.push",
          "memories.read"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}